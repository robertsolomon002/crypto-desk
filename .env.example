# Crypto Desk: local secrets template
# 1) Copy this file to `.env` in C:\Users\rober\code\crypto-desk  (the .env file is never committed)
# 2) Fill in each value as you create the account/key (Stage 0.1 in ROADMAP.md)
# 3) Add the same names + values as GitHub Actions secrets (repo Settings > Secrets and variables > Actions)
# Never paste these values into a chat.

# --- Database (Neon) ---
DATABASE_URL=                      # Neon "pooled" connection string (postgresql://...-pooler.../neondb?sslmode=require)
# TEST_DATABASE_URL=                # local Postgres server for tests (docker compose); never Neon

# --- Auth (Clerk) ---
CLERK_SECRET_KEY=                  # sk_test_... (backend)
VITE_CLERK_PUBLISHABLE_KEY=        # pk_test_... (frontend)

# --- LLMs ---
ANTHROPIC_API_KEY=                 # sk-ant-...  (server key; set a $6/month limit, auto-reload off)
GOOGLE_API_KEY=                    # Gemini key from Google AI Studio (MCO video summaries)
OPENROUTER_API_KEY=                # sk-or-...  (only to test the friends' bring-your-own-key path; set a $2 limit)

# --- Data sources (free) ---
FRED_API_KEY=                      # fred.stlouisfed.org > My Account > API Keys
COINGECKO_DEMO_KEY=                # CG-...  (free Demo plan)

# --- Alerts ---
TELEGRAM_BOT_TOKEN=                # from @BotFather
TELEGRAM_CHAT_ID=                  # from https://api.telegram.org/bot<TOKEN>/getUpdates after messaging your bot
DISCORD_WEBHOOK_URL=               # #crypto-desk channel webhook (friends see these)
DISCORD_OPS_WEBHOOK_URL=           # optional: private #ops channel webhook (only you)

# --- Tracing (optional) ---
LANGSMITH_API_KEY=                 # lsv2_...
LANGSMITH_PROJECT=crypto-desk
LANGSMITH_TRACING=true

# --- Google Cloud (Cloud Run) ---
GCP_PROJECT_ID=                    # e.g. crypto-desk-123456
GCP_REGION=us-central1             # Claude Code confirms the free-tier region in Stage 0.3

# --- Cloudflare Pages (needed from Stage 2.2; can fill later) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=              # token with "Cloudflare Pages: Edit" permission

# --- App (added in Stage 0.2; defaults are fine for local dev) ---
MCO_ENABLED=true                   # Decision 6: set false to switch the MCO tab and pipeline off
CORS_ORIGINS=                      # JSON list of allowed frontend origins, e.g. ["https://crypto-desk.pages.dev"]; empty = localhost dev ports
VITE_API_BASE_URL=                 # frontend -> backend URL (Cloud Run) in production; empty in dev (Vite proxies /api to :8000)
